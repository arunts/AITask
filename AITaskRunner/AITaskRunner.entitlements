<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks Apple Events unless declared. Without this, a task that runs
	     `osascript` through the Shell tool fails silently in the signed build. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
